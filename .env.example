# Copiar este archivo como .env y completar con los datos locales.
# El archivo .env no se sube al repositorio.
ARTICULOS_DB_URL=jdbc:postgresql://localhost:5432/bodega_articulos
ARTICULOS_DB_USERNAME=cambiar_por_tu_usuario
ARTICULOS_DB_PASSWORD=cambiar_por_tu_clave
ARTICULOS_ADDRESS=127.0.0.1
ARTICULOS_PORT=8082
# Opcional: secreto que envía el API Gateway (X-Gateway-Secret). Vacío = no se exige.
GATEWAY_SECRET=
# Opcional: URL de la cola SQS de eventos. Si se deja vacía, no se publican eventos.
SQS_COLA_URL=
AWS_REGION=us-east-1
